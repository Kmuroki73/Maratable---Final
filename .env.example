# Cloudflare Turnstile — add the site key to the page and keep the secret server-side.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Preferred email provider: SMTP2GO. Verify maratable.com and this sender in SMTP2GO first.
SMTP2GO_API_KEY=your-smtp2go-api-key
SMTP2GO_FROM="MaraTable Website <website@maratable.com>"

# Enquiries are delivered to both addresses unless CONTACT_TO is set differently.
CONTACT_TO=info@maratablegroup.com,nancy@maratable.com

# Optional fallback provider. SMTP2GO takes priority when SMTP2GO_API_KEY is configured.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM="MaraTable Website <website@maratable.com>"
